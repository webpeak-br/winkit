<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#141318" Foreground="#ECEAF2"
        FontFamily="Segoe UI" FontSize="13" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#1E1D24"/>
    <SolidColorBrush x:Key="Line" Color="#2E2C38"/>
    <SolidColorBrush x:Key="Muted" Color="#A3A0B3"/>
    <SolidColorBrush x:Key="Brand" Color="#5A44CD"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#26242E"/>
      <Setter Property="Foreground" Value="#ECEAF2"/>
      <Setter Property="BorderBrush" Value="#3A3846"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#B5BAFE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#5A44CD"/>
      <Setter Property="BorderBrush" Value="#5A44CD"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECEAF2"/>
      <Setter Property="Margin" Value="0,4,18,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A3A0B3"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#1E1D24"/>
      <Setter Property="BorderBrush" Value="#2E2C38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Menu lateral -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="#18171D" BorderBrush="#2E2C38" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
          <Border Width="30" Height="30" CornerRadius="8" Background="#5A44CD">
            <TextBlock Text="W" Foreground="#E7F727" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="WinKit" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="Version" DockPanel.Dock="Bottom" Foreground="#6E6B7E" FontSize="11" Margin="8,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="NavPanel">
          <Button x:Name="NavOverview" Style="{StaticResource Nav}" Content="Visão geral" Tag="PageOverview"/>
          <Button x:Name="NavHealth" Style="{StaticResource Nav}" Content="Diagnóstico" Tag="PageHealth"/>
          <Button x:Name="NavApps" Style="{StaticResource Nav}" Content="Aplicativos" Tag="PageApps"/>
          <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Content="Atualizações" Tag="PageUpdates"/>
          <Button x:Name="NavMaint" Style="{StaticResource Nav}" Content="Manutenção" Tag="PageMaint"/>
          <Button x:Name="NavHistory" Style="{StaticResource Nav}" Content="Histórico e desfazer" Tag="PageHistory"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Conteúdo -->
    <Grid Grid.Column="1" Grid.Row="0" Margin="26,20,26,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,12">
        <DockPanel>
          <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Background="#2E2C38" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="sem diagnóstico" FontSize="12"/>
          </Border>
          <StackPanel>
            <TextBlock x:Name="MachineName" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="MachineInfo" Foreground="#A3A0B3" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <!-- Visão geral -->
        <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Visão geral"/>
            <TextBlock Style="{StaticResource Sub}" Text="Estado da máquina agora. O diagnóstico completo fica na tela Diagnóstico."/>
            <WrapPanel x:Name="Cards"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="BtnQuickHealth" Style="{StaticResource Primary}" Content="Rodar diagnóstico completo"/>
              <Button x:Name="BtnRefresh" Content="Atualizar"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Diagnóstico -->
        <ScrollViewer x:Name="PageHealth" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Diagnóstico"/>
            <TextBlock Style="{StaticResource Sub}" Text="Discos e SMART, erros do sistema, telas azuis, antivírus, firewall, drivers, atualizações e integridade do Windows. Não altera nada."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button x:Name="BtnRunHealth" Style="{StaticResource Primary}" Content="Executar diagnóstico"/>
              <Button x:Name="BtnOpenReport" Content="Abrir relatório completo" IsEnabled="False"/>
            </StackPanel>
            <StackPanel x:Name="HealthList"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Aplicativos -->
        <DockPanel x:Name="PageApps" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Aplicativos"/>
            <TextBlock Style="{StaticResource Sub}" Text="Marque e instale de uma vez, direto das fontes oficiais (winget). Os já instalados aparecem marcados em verde."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnAppsInstall" Style="{StaticResource Primary}" Content="Instalar selecionados"/>
              <Button x:Name="BtnAppsCheck" Content="Verificar instalados"/>
              <Button x:Name="BtnAppsUpgrade" Content="Atualizar todos os programas"/>
              <Button x:Name="BtnAppsClear" Content="Limpar seleção"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AppsList"/></ScrollViewer>
        </DockPanel>

        <!-- Atualizações -->
        <DockPanel x:Name="PageUpdates" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Atualizações do Windows"/>
            <TextBlock Style="{StaticResource Sub}" Text="Busca no Windows Update (ou no WSUS da empresa) e instala as marcadas. Se precisar reiniciar, o WinKit avisa e não reinicia sozinho."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnUpdFind" Style="{StaticResource Primary}" Content="Procurar atualizações"/>
              <Button x:Name="BtnUpdInstall" Content="Instalar marcadas" IsEnabled="False"/>
              <CheckBox x:Name="ChkDrivers" Content="Incluir drivers" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="UpdList"/></ScrollViewer>
        </DockPanel>

        <!-- Manutenção -->
        <ScrollViewer x:Name="PageMaint" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Manutenção"/>
            <TextBlock Style="{StaticResource Sub}" Text="Reparos seguros. Tudo fica registrado no Histórico."/>
            <Border Style="{StaticResource Panel}">
              <DockPanel>
                <Button x:Name="BtnRepair" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Reparar"/>
                <StackPanel><TextBlock Text="Reparar o Windows (DISM + SFC)" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Foreground="#A3A0B3" TextWrapping="Wrap" Text="Corrige arquivos do sistema corrompidos. Leva de 20 a 60 minutos; dá para continuar usando o computador."/></StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <DockPanel>
                <Button x:Name="BtnRestorePoint" DockPanel.Dock="Right" Content="Criar"/>
                <StackPanel><TextBlock Text="Ponto de restauração" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Foreground="#A3A0B3" TextWrapping="Wrap" Text="Cria um ponto para voltar o sistema, se algo der errado depois."/></StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <DockPanel>
                <Button x:Name="BtnOpenData" DockPanel.Dock="Right" Content="Abrir pasta"/>
                <StackPanel><TextBlock Text="Relatórios e logs" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Foreground="#A3A0B3" TextWrapping="Wrap" Text="Tudo o que o WinKit fez fica em %ProgramData%\WinKit\runs."/></StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Histórico -->
        <DockPanel x:Name="PageHistory" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Histórico e desfazer"/>
            <TextBlock Style="{StaticResource Sub}" Text="Cada execução guarda o estado anterior do que mudou. Desfazer volta registro, serviços e programas instalados pelo WinKit."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnHistReload" Content="Atualizar lista"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HistList"/></ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>

    <!-- Barra de andamento e log -->
    <Border Grid.Column="1" Grid.Row="1" Background="#18171D" BorderBrush="#2E2C38" BorderThickness="0,1,0,0" Padding="26,8">
      <StackPanel>
        <DockPanel>
          <Button x:Name="BtnToggleLog" DockPanel.Dock="Right" Content="Mostrar log" Padding="10,3" Margin="0"/>
          <ProgressBar x:Name="Busy" DockPanel.Dock="Left" Width="120" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" Foreground="#5A44CD" Background="#2E2C38" BorderThickness="0"/>
          <TextBlock x:Name="StatusLine" Foreground="#A3A0B3" VerticalAlignment="Center" Text="Pronto."/>
        </DockPanel>
        <TextBox x:Name="LogBox" Height="150" Margin="0,8,0,0" Visibility="Collapsed" IsReadOnly="True" Background="#0B0A0E" Foreground="#C9C6D6"
                 BorderBrush="#2E2C38" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
